{
  "name": "@nyxcinc/design-system",
  "version": "0.1.0",
  "description": "Shared design tokens, primitives, and layout shells for nyxc frontends",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens/index.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./primitives.css": "./dist/index.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyxcInc/nyxcCC-Landing.git",
    "directory": "packages/design-system"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/react-vite": "^10.5.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^10.5.3",
    "typescript": "^5",
    "vite": "^8.1.5"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  }
}
